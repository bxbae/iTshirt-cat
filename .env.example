# mock = offline demo (no API key). anthropic = real LLM for reply drafts.
# Refund/compensation decisions never depend on this: they come from the rule engine.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high (thinking depth); empty = model default
ANTHROPIC_EFFORT=low
AGENT_NAME=배상담
BRAND_NAME=캣북스 고객센터
CORS_ORIGINS=http://localhost:3000
# 1 = create demo customers, orders, claims and inquiries on first start
SEED_DEMO=1
# 1 = enable the "advance shipping" demo buttons on the order page
DEMO_TOOLS=1
APP_TIMEZONE=Asia/Seoul
